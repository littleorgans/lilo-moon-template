# Copy to .env.local. Every .env* file is gitignored except this one, so real values never
# get committed. Names and shapes live here; values do not.
#
# The copy is loaded by moon, via `envFile` on the dev and preview tasks in
# .moon/tasks/node-application.yml. Vite does not load it: Vite reads .env files only to populate
# import.meta.env, and looks beside vite.config.ts rather than here. Running `vite` directly,
# outside moon, therefore starts a server with none of this set.
#
# Nothing in packages/ reads this file. Those packages take configuration as arguments, so a
# secret can never be picked up implicitly by a library. The application composes the values
# below and passes them in. That is deliberate: it keeps the packages testable and portable.

# ---------------------------------------------------------------------------------------------
# Identity: WorkOS
# ---------------------------------------------------------------------------------------------

# Public. Identifies the AuthKit application. Safe in a client bundle, and it is the value the
# issuer and JWKS URL below are derived from.
WORKOS_CLIENT_ID=client_xxxxxxxxxxxxxxxxxxxxxxxxxx

# SECRET. Server only, and used only by packages/auth-workos. Exchanging an authorization code
# for tokens needs it. It must never reach the browser.
#
# Deliberately not written as a realistic-looking key. WorkOS secret keys share the `sk_test_`
# prefix that Stripe uses, so a plausible placeholder fails `moon run root:secrets`. That gate
# caught this exact line, which is a fair demonstration that it works.
WORKOS_API_KEY=copy_the_secret_key_from_the_workos_dashboard

# Must match a redirect URI registered on the AuthKit application exactly, including the port.
# A mismatch fails at the provider with an error that points at the wrong system.
WORKOS_REDIRECT_URI=http://localhost:5199/callback

# SECRET. At least 32 characters. Seals the session cookie so the refresh token inside it cannot
# be read even by someone holding the cookie.
WORKOS_COOKIE_PASSWORD=generate_at_least_32_random_characters

# Derived, not configured. Recorded here so nobody hardcodes a guess:
#   issuer   https://api.workos.com/user_management/${WORKOS_CLIENT_ID}
#   JWKS     https://api.workos.com/sso/jwks/${WORKOS_CLIENT_ID}
# Both are published at
#   https://api.workos.com/user_management/${WORKOS_CLIENT_ID}/.well-known/openid-configuration
# and were verified against the live environment. Prefer discovery over hardcoding either one.

# ---------------------------------------------------------------------------------------------
# Persistence: Postgres
# ---------------------------------------------------------------------------------------------

# SECRET. Read by `moon run root:atlas-apply` and by packages/db at runtime.
#
# The application connects as a role that can `SET LOCAL ROLE authenticated`, never as the table
# owner. Row level security is FORCEd, so an owner connection would bypass nothing, but a
# superuser connection still bypasses every policy. Do not use one.
#
# On a pooled connection, use the transaction-mode port and do not call Drizzle's `.prepare()`.
DATABASE_URL=postgres://user:password@host:6543/postgres?sslmode=require

# ---------------------------------------------------------------------------------------------
# Not set here
# ---------------------------------------------------------------------------------------------
#
# CI          Set by the CI runner. Docker-dependent gates skip locally when it is absent and
#             run unconditionally when it is present.
# MOON_BASE   Set by moon. Selects the Atlas lint range.
#
# These are GitHub Actions settings rather than process environment, and are documented in
# docs/how-to-instantiate.md:
#
#   CI_RUNNER             variable. Unset means ubuntu-latest.
#   NPM_PUBLISH_ENABLED   variable. Unset means Changesets versions but never publishes.
#   HELIOY_PAT            secret. Authors the Version Packages PR so it is not approval-blocked.
#
# WORKOS_CLAIM_TOKEN is written by `npx workos@latest` when it provisions an environment. No code
# in this repository reads it. Keep it out of the application's configuration.
