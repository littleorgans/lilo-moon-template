# dependencies
node_modules/

# moon
.moon/cache/
.moon/docker/

# build output
dist/
.output/
build/
# Not output: `build` is a skill domain, as in skills/lilo/build/start-project.
!/skills/*/build/
out/
coverage/
*.tsbuildinfo

# environment. .env, .env.local, .env.production, and every other .env* variant.
.env*
!.env.example

# editors and os
.DS_Store
*.pem

# local lefthook overrides
lefthook-local.yml

# nested git worktrees, so secretlint and other .gitignore readers skip them
.worktrees/
