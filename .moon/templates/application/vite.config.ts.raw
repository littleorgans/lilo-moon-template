import { workspaceSourceConfig } from "@lilo-moon/vite-config";
import react from "@vitejs/plugin-react";
import { defineConfig } from "vite";

export default defineConfig((env) => ({
  plugins: [react()],
  // Makes workspace packages resolve to their source while serving. Three settings that have to
  // agree; see @lilo-moon/vite-config for what each one prevents.
  ...workspaceSourceConfig(env),
}));
