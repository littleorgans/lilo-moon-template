{
  "name": "@littleorgans/drizzle-schema",
  "version": "0.0.0",
  "private": true,
  "description": "This project's typed Drizzle schema, generated from its migrations by db-tools drizzle-generate.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/schema.d.ts",
  "exports": {
    ".": {
      "types": "./dist/schema.d.ts",
      "@littleorgans/source": "./_generated/schema.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    }
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:"
  }
}
