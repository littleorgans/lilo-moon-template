{
  "name": "@littleorgans/db-tools",
  "version": "0.0.0",
  "description": "Prove Postgres row level security holds in your own database, with the rls-verify CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littleorgans/lilo-moon-template.git",
    "directory": "packages/db-tools"
  },
  "bin": {
    "rls-verify": "./bin/rls-verify.js"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@littleorgans/source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "devDependencies": {
    "@littleorgans/db": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:"
  },
  "peerDependencies": {
    "@littleorgans/db": "workspace:^",
    "pg": "catalog:db-peer"
  },
  "peerDependenciesMeta": {
    "@littleorgans/db": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
