{
  "name": "@littleorgans/db",
  "version": "0.0.0",
  "description": "Postgres access scoped to a verified Principal by row level security.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littleorgans/lilo-moon-template.git",
    "directory": "packages/db"
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "grants"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@littleorgans/source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./migrations/*": "./migrations/*",
    "./grants/*": "./grants/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@littleorgans/auth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "peerDependencies": {
    "@types/pg": "catalog:db-peer",
    "drizzle-orm": "catalog:db-peer",
    "pg": "catalog:db-peer"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
