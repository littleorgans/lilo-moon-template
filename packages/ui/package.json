{
  "name": "@littleorgans/ui",
  "version": "0.2.0",
  "description": "Shared React components: shadcn primitives, layout, and the Tailwind entry stylesheet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littleorgans/lilo-moon-template.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./globals.css": "./src/globals.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "@littleorgans/source": "./src/components/*.tsx",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "@littleorgans/source": "./src/lib/*.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./globals.css": "./src/globals.css",
      "./components/*": {
        "types": "./dist/components/*.d.ts",
        "import": "./dist/components/*.js",
        "default": "./dist/components/*.js"
      },
      "./lib/*": {
        "types": "./dist/lib/*.d.ts",
        "import": "./dist/lib/*.js",
        "default": "./dist/lib/*.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@littleorgans/theme": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "radix-ui": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react-peer",
    "react-dom": "catalog:react-peer",
    "tailwindcss": "catalog:tailwind-peer"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
