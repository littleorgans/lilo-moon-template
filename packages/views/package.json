{
  "name": "@littleorgans/views",
  "version": "0.2.1",
  "description": "Reusable screens composed from UI building blocks, with application-supplied labels and paths.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littleorgans/lilo-moon-template.git",
    "directory": "packages/views"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./sources.css": "./src/sources.css",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "@littleorgans/source": "./src/*/index.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      "./sources.css": "./src/sources.css",
      "./*": {
        "types": "./dist/*/index.d.ts",
        "import": "./dist/*/index.js",
        "default": "./dist/*/index.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@littleorgans/theme": "workspace:*",
    "@littleorgans/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react-peer",
    "react-dom": "catalog:react-peer"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
