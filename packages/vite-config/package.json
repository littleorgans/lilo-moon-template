{
  "name": "@littleorgans/vite-config",
  "version": "0.2.1",
  "description": "Workspace source resolution for Vite configs, and the Vitest defaults a workspace shares.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littleorgans/lilo-moon-template.git",
    "directory": "packages/vite-config"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vitest": {
      "types": "./src/vitest.ts",
      "default": "./src/vitest.ts"
    }
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./vitest": {
        "types": "./dist/vitest.d.ts",
        "import": "./dist/vitest.js",
        "default": "./dist/vitest.js"
      }
    },
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": "catalog:vite-peer",
    "vitest": "catalog:vitest-peer"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
